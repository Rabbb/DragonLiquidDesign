{
  "name": "@dragon-liquid/showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:api": "node scripts/generate-component-api.mjs",
    "audit:docs": "node --no-warnings --experimental-strip-types scripts/audit-component-docs.mjs",
    "audit:patterns": "node --no-warnings --experimental-strip-types scripts/audit-pattern-coverage.mjs",
    "prebuild": "npm run generate:api && npm run audit:docs && npm run audit:patterns",
    "build": "vue-tsc --noEmit && vite build",
    "postbuild": "node scripts/create-static-routes.mjs",
    "predev": "npm run generate:api && npm run audit:docs && npm run audit:patterns",
    "dev": "vite"
  },
  "dependencies": {
    "@dragon-liquid/vue": "file:../../registry/dragon-liquid-vue-0.6.0-alpha.33.tgz",
    "vue": "^3.5.40",
    "vxe-pc-ui": "~4.16.24",
    "vxe-table": "~4.20.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "5.9.3",
    "vite": "^8.0.3",
    "vue-tsc": "^3.0.0"
  }
}
